{
  "name": "Adones Theme",
  "$schema": "vscode://schemas/color-theme",
  "type": "dark",
  "semanticHighlighting": true,

  "semanticTokenColors": {
    "variable": "#D0D6CF",
    "variable.readonly": "#D0D6CF",
    "property": "#C7D0C9",
    "parameter": "#A9B7B0",
    "function": "#DEBA6E",
    "method": "#DEBA6E",
    "class": "#4FAE97",
    "interface": "#4FAE97",
    "enum": "#4FAE97",
    "namespace": "#72AFA4",
    "type": "#9C8FD1",
    "typeParameter": "#9C8FD1",
    "enumMember": "#DEBA6E",
    "decorator": "#72AFA4",
    "macro": "#72AFA4",
    "keyword": "#6E9FCB",
    "modifier": "#6E9FCB",
    "operator": "#C2AD8E",
    "comment": "#6B7A73",
    "string": "#8FC79B",
    "number": "#D99E6C",
    "boolean": "#D99E6C"
  },

  "colors": {
    "foreground": "#D0D6CF",

    "editor.background": "#202B32",
    "editor.foreground": "#D0D6CF",

    "editor.lineHighlightBackground": "#263540",
    "editor.lineHighlightBorder": "#00000000",

    "editor.selectionBackground": "#56717A70",
    "editor.selectionHighlightBackground": "#56717A40",
    "editor.inactiveSelectionBackground": "#56717A40",

    "editor.wordHighlightBackground": "#56717A40",
    "editor.wordHighlightStrongBackground": "#56717A60",

    "editorCursor.foreground": "#8FC79B",

    "editorLineNumber.foreground": "#607078",
    "editorLineNumber.activeForeground": "#B4C0B9",

    "editorIndentGuide.background": "#34434B",
    "editorIndentGuide.activeBackground": "#50636B",

    "editorWhitespace.foreground": "#526169",

    "editorBracketMatch.background": "#34454D",
    "editorBracketMatch.border": "#72AFA480",

    "editorBracketHighlight.foreground1": "#8FC79B",
    "editorBracketHighlight.foreground2": "#6E9FCB",
    "editorBracketHighlight.foreground3": "#DEBA6E",
    "editorBracketHighlight.foreground4": "#72AFA4",
    "editorBracketHighlight.foreground5": "#B28F6F",
    "editorBracketHighlight.foreground6": "#D58E6F",
    "editorBracketHighlight.unexpectedBracket.foreground": "#D47778",

    "editor.findMatchBackground": "#DEBA6E35",
    "editor.findMatchHighlightBackground": "#8FC79B30",
    "editor.findMatchBorder": "#DEBA6E80",

    "editorHoverWidget.background": "#2C3C45",
    "editorHoverWidget.border": "#43545D",

    "editorSuggestWidget.background": "#2C3C45",
    "editorSuggestWidget.foreground": "#D0D6CF",
    "editorSuggestWidget.highlightForeground": "#8FC79B",
    "editorSuggestWidget.selectedBackground": "#374A54",
    "editorSuggestWidget.border": "#43545D",

    "editorWidget.background": "#2C3C45",
    "editorWidget.border": "#43545D",

    "editorInfo.foreground": "#72AFA4",
    "editorWarning.foreground": "#DEBA6E",
    "editorError.foreground": "#D47778",

    "editorOverviewRuler.border": "#00000000",
    "editorOverviewRuler.findMatchForeground": "#8FC79B80",
    "editorOverviewRuler.infoForeground": "#72AFA480",
    "editorOverviewRuler.warningForeground": "#DEBA6E80",
    "editorOverviewRuler.errorForeground": "#D4777880",

    "editorGutter.addedBackground": "#8FC79B80",
    "editorGutter.modifiedBackground": "#6E9FCB80",
    "editorGutter.deletedBackground": "#D4777880",

    "editorGroup.border": "#34434B",
    "editorGroupHeader.tabsBackground": "#202B32",

    "activityBar.background": "#171F25",
    "activityBar.foreground": "#D0D6CF",
    "activityBar.inactiveForeground": "#718079",
    "activityBar.activeBorder": "#8FC79B",
    "activityBarBadge.background": "#8FC79B",
    "activityBarBadge.foreground": "#202B32",

    "sideBar.background": "#171F25",
    "sideBar.foreground": "#A8B3AD",
    "sideBar.border": "#34434B",
    "sideBarTitle.foreground": "#D0D6CF",

    "sideBarSectionHeader.background": "#202B32",
    "sideBarSectionHeader.foreground": "#A8B3AD",
    "sideBarSectionHeader.border": "#34434B",

    "list.hoverBackground": "#2A3941",
    "list.hoverForeground": "#D0D6CF",
    "list.activeSelectionBackground": "#374A54",
    "list.activeSelectionForeground": "#D0D6CF",
    "list.inactiveSelectionBackground": "#2A3941",
    "list.inactiveSelectionForeground": "#A8B3AD",
    "list.focusBackground": "#374A54",
    "list.highlightForeground": "#8FC79B",

    "tab.activeBackground": "#26343E",
    "tab.activeForeground": "#D0D6CF",
    "tab.activeBorder": "#8FC79B",
    "tab.inactiveBackground": "#171F25",
    "tab.inactiveForeground": "#718079",
    "tab.hoverBackground": "#2A3941",
    "tab.hoverForeground": "#C2CBC5",
    "tab.border": "#171F25",

    "titleBar.activeBackground": "#171F25",
    "titleBar.activeForeground": "#A8B3AD",
    "titleBar.inactiveBackground": "#171F25",
    "titleBar.inactiveForeground": "#68766F",
    "titleBar.border": "#34434B",

    "statusBar.background": "#171F25",
    "statusBar.foreground": "#9AA8A0",
    "statusBar.border": "#34434B",
    "statusBar.debuggingBackground": "#6E9FCB",
    "statusBar.debuggingForeground": "#202B32",

    "panel.background": "#202B32",
    "panel.border": "#34434B",
    "panelTitle.activeForeground": "#D0D6CF",
    "panelTitle.activeBorder": "#8FC79B",
    "panelTitle.inactiveForeground": "#718079",

    "input.background": "#2A3941",
    "input.foreground": "#D0D6CF",
    "input.border": "#43545D",
    "input.placeholderForeground": "#718079",

    "dropdown.background": "#2A3941",
    "dropdown.foreground": "#D0D6CF",
    "dropdown.border": "#43545D",

    "button.background": "#4E7268",
    "button.foreground": "#D8DED9",
    "button.hoverBackground": "#5C8175",

    "menu.background": "#2A3941",
    "menu.foreground": "#D0D6CF",
    "menu.selectionBackground": "#374A54",
    "menu.selectionForeground": "#D8DED9",
    "menu.border": "#43545D",

    "minimap.background": "#202B32",
    "minimapSlider.background": "#56717A50",
    "minimapSlider.hoverBackground": "#56717A70",
    "minimapSlider.activeBackground": "#8FC79B70",

    "scrollbar.shadow": "#00000000",
    "scrollbarSlider.background": "#56717A40",
    "scrollbarSlider.hoverBackground": "#56717A70",
    "scrollbarSlider.activeBackground": "#8FC79B70",

    "textLink.foreground": "#8FC79B",
    "textLink.activeForeground": "#AECFB6",

    "badge.background": "#8FC79B",
    "badge.foreground": "#202B32",

    "progressBar.background": "#8FC79B",

    "notificationCenterHeader.background": "#2A3941",
    "notificationCenterHeader.foreground": "#D0D6CF",

    "notifications.background": "#2A3941",
    "notifications.foreground": "#D0D6CF",

    "notificationsInfoIcon.foreground": "#72AFA4",
    "notificationsWarningIcon.foreground": "#DEBA6E",
    "notificationsErrorIcon.foreground": "#D47778",

    "gitDecoration.addedResourceForeground": "#8FC79B",
    "gitDecoration.modifiedResourceForeground": "#6E9FCB",
    "gitDecoration.deletedResourceForeground": "#D47778",
    "gitDecoration.untrackedResourceForeground": "#DEBA6E",
    "gitDecoration.ignoredResourceForeground": "#607078",
    "gitDecoration.conflictingResourceForeground": "#D58E6F",

    "debugToolBar.background": "#2A3941",

    "terminal.background": "#202B32",
    "terminal.foreground": "#D0D6CF",
    "terminalCursor.foreground": "#8FC79B",

    "terminal.ansiBlack": "#29373F",
    "terminal.ansiRed": "#D47778",
    "terminal.ansiGreen": "#8FC79B",
    "terminal.ansiYellow": "#DEBA6E",
    "terminal.ansiBlue": "#6E9FCB",
    "terminal.ansiMagenta": "#9C8FD1",
    "terminal.ansiCyan": "#72AFA4",
    "terminal.ansiWhite": "#D0D6CF",

    "terminal.ansiBrightBlack": "#607078",
    "terminal.ansiBrightRed": "#E08A8B",
    "terminal.ansiBrightGreen": "#A3D3AC",
    "terminal.ansiBrightYellow": "#E8C990",
    "terminal.ansiBrightBlue": "#9AC0E0",
    "terminal.ansiBrightMagenta": "#BAAEE0",
    "terminal.ansiBrightCyan": "#8CC5BB",
    "terminal.ansiBrightWhite": "#DEE3DF",

    "tree.indentGuidesStroke": "#34434B",
    "widget.shadow": "#00000040",
    "focusBorder": "#8FC79B70"
  },

  "tokenColors": [

    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6B7A73",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.delete",
        "storage.type",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.enum",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#6E9FCB"
      }
    },

    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#C2AD8E"
      }
    },

    {
      "name": "HTML Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.localname.xml",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html"
      ],
      "settings": {
        "foreground": "#72AFA4"
      }
    },

    {
      "name": "HTML Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "#DEBA6E"
      }
    },

    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double",
        "string.quoted.single",
        "string.quoted.double.html",
        "string.quoted.single.html",
        "string.quoted.double.js",
        "string.quoted.single.js"
      ],
      "settings": {
        "foreground": "#8FC79B"
      }
    },

    {
      "name": "String Escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "variable.interpolation"
      ],
      "settings": {
        "foreground": "#DEBA6E"
      }
    },

    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "variable.function",
        "meta.function",
        "meta.function-call",
        "meta.definition.method",
        "entity.name.method"
      ],
      "settings": {
        "foreground": "#DEBA6E"
      }
    },

    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#D0D6CF"
      }
    },

    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#C7D0C9"
      }
    },

    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#D99E6C"
      }
    },

    {
      "name": "Booleans and Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "support.constant"
      ],
      "settings": {
        "foreground": "#D99E6C"
      }
    },

    {
      "name": "Types",
      "scope": [
        "storage.type",
        "support.type",
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#9C8FD1"
      }
    },

    {
      "name": "CSS Properties",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#72AFA4"
      }
    },

    {
      "name": "CSS Selectors",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css",
        "meta.selector.css"
      ],
      "settings": {
        "foreground": "#6E9FCB"
      }
    },

    {
      "name": "CSS Values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "constant.numeric.css",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#DEBA6E"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "meta.brace",
        "meta.bracket",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8FA098"
      }
    },

    {
      "name": "Markup",
      "scope": [
        "markup.heading",
        "markup.bold",
        "markup.italic"
      ],
      "settings": {
        "foreground": "#DEBA6E"
      }
    },

    {
      "name": "Markdown Links",
      "scope": [
        "string.other.link",
        "string.other.link.title.markdown",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "foreground": "#8FC79B",
        "fontStyle": "underline"
      }
    },

    {
      "name": "Regular Expressions",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8FC79B"
      }
    },

    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#D47778"
      }
    },

    {
      "name": "Decorators",
      "scope": [
        "punctuation.decorator",
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#72AFA4"
      }
    }
  ]
}